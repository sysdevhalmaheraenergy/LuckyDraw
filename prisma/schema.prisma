generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  events    Event[]
}

model Event {
  id           String      @id @default(cuid())
  name         String
  description  String?
  totalCoupons Int
  status       EventStatus @default(DRAFT)
  userId       String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  coupons      Coupon[]
  user         User        @relation(fields: [userId], references: [id])
  prizes       Prize[]
}

model Coupon {
  id          String       @id @default(cuid())
  number      Int
  status      CouponStatus @default(AVAILABLE)
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id])
  drawResults DrawResult[]

  @@unique([eventId, number])
  @@index([eventId, status])
}

model Prize {
  id          String       @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  drawOrder   Int
  status      PrizeStatus  @default(PENDING)
  eventId     String
  drawResults DrawResult[]
  event       Event        @relation(fields: [eventId], references: [id])
}

model DrawResult {
  id       String           @id @default(cuid())
  prizeId  String
  couponId String
  status   DrawResultStatus @default(VALID)
  drawnAt  DateTime         @default(now())
  undoneAt DateTime?
  coupon   Coupon           @relation(fields: [couponId], references: [id])
  prize    Prize            @relation(fields: [prizeId], references: [id])
}

enum Role {
  ADMIN
  STAFF
}

enum EventStatus {
  DRAFT
  ONGOING
  COMPLETED
}

enum CouponStatus {
  AVAILABLE
  WON
  EXCLUDED
}

enum PrizeStatus {
  PENDING
  DRAWN
}

enum DrawResultStatus {
  VALID
  UNDONE
}
